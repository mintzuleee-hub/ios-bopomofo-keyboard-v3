<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ios_bg"
    android:orientation="vertical"
    android:paddingBottom="2dp">

    <!-- 目前正在輸入的注音預覽 -->
    <TextView
        android:id="@+id/tv_composing"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="@color/ios_bg"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:textColor="@color/ios_subtext_color"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 候選字詞列 -->
    <LinearLayout
        android:id="@+id/candidate_divider_row"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@color/ios_candidate_divider"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_candidates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tv_expand_candidates"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="∨"
            android:textColor="@color/ios_subtext_color"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 展開後的候選清單 (緊湊網格) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_candidates_expanded"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@color/ios_bg"
        android:visibility="gone" />

    <!-- 鍵盤主體 -->
    <LinearLayout
        android:id="@+id/keyboard_rows_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="2dp"
        android:paddingTop="2dp"
        android:paddingRight="2dp" />

    <!-- 第五列 (小地球 + 語音) -->
    <LinearLayout
        android:id="@+id/keyboard_bottom_system_row"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp">

        <ImageButton
            android:id="@+id/btn_globe"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="切換鍵盤"
            android:padding="8dp"
            android:src="@drawable/ic_globe"
            android:tint="@color/ios_text_color" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="語音輸入"
            android:padding="8dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/ios_text_color" />
    </LinearLayout>

</LinearLayout>
